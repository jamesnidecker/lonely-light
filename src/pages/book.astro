---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Book a Session — James Nidecker Tattoo Artist Amsterdam</title>
    <meta name="description" content="Request a custom geometric, mandala or blackout tattoo session with James Nidecker in Amsterdam." />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body style="background:#000; color:#fff; margin:0; padding:0; font-family:'Space Grotesk',sans-serif;">

    <!-- NAV -->
    <nav style="position:fixed; top:0; width:100%; background:#000; border-bottom:1px solid #111; z-index:50; padding:20px 40px; display:flex; align-items:center; justify-content:space-between;">
      <a href="/" style="font-weight:700; letter-spacing:0.2em; text-transform:uppercase; font-size:14px; color:#fff; text-decoration:none;">James Nidecker</a>
      <div style="display:flex; gap:32px; font-size:12px; letter-spacing:0.15em; text-transform:uppercase;">
        <a href="/#work" style="color:#666; text-decoration:none;">Work</a>
        <a href="/#about" style="color:#666; text-decoration:none;">About</a>
        <a href="/#services" style="color:#666; text-decoration:none;">Services</a>
        <a href="/#process" style="color:#666; text-decoration:none;">Process</a>
        <a href="/#faq" style="color:#666; text-decoration:none;">FAQ</a>
        <a href="/blog" style="color:#666; text-decoration:none;">Blog</a>
      </div>
      <a href="/book" style="background:#C9A84C; color:#000; padding:12px 24px; font-weight:700; font-size:11px; letter-spacing:0.15em; text-transform:uppercase; text-decoration:none;">Book Now</a>
    </nav>

    <!-- HEADER -->
    <section style="padding:160px 40px 60px; max-width:720px; margin:0 auto; text-align:center;">
      <p style="color:#C9A84C; font-size:12px; letter-spacing:0.2em; text-transform:uppercase; margin-bottom:16px;">Book Your Session</p>
      <h1 style="font-size:36px; margin-bottom:20px;">Let's design your piece</h1>
      <p style="color:#888; line-height:1.8; font-size:15px;">
        Fill in the form below with as much detail as possible. James reviews every request personally and
        will get back to you by email to discuss your idea, availability and next steps.
      </p>
    </section>

    <!-- FORM -->
    <section style="padding:0 40px 120px; max-width:640px; margin:0 auto;">
      <form
        name="booking"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        enctype="multipart/form-data"
        action="/book/success"
        id="booking-form"
      >
        <input type="hidden" name="form-name" value="booking" />
        <p style="display:none;">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div style="margin-bottom:28px;">
          <label style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#888; margin-bottom:8px;">Subject</label>
          <input type="text" name="subject" required placeholder="example: Custom mandala sleeve inquiry"
            style="width:100%; box-sizing:border-box; background:#0a0a0a; border:1px solid #222; color:#fff; padding:14px 16px; font-family:inherit; font-size:14px;" />
        </div>

        <div style="display:flex; gap:16px; margin-bottom:28px;">
          <div style="flex:1;">
            <label style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#888; margin-bottom:8px;">Name</label>
            <input type="text" name="name" required
              style="width:100%; box-sizing:border-box; background:#0a0a0a; border:1px solid #222; color:#fff; padding:14px 16px; font-family:inherit; font-size:14px;" />
          </div>
          <div style="width:110px;">
            <label style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#888; margin-bottom:8px;">Your age</label>
            <input type="number" name="age" min="18" required
              style="width:100%; box-sizing:border-box; background:#0a0a0a; border:1px solid #222; color:#fff; padding:14px 16px; font-family:inherit; font-size:14px;" />
          </div>
        </div>

        <div style="display:flex; gap:16px; margin-bottom:28px;">
          <div style="flex:1;">
            <label style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#888; margin-bottom:8px;">Country</label>
            <input type="text" name="country" required
              style="width:100%; box-sizing:border-box; background:#0a0a0a; border:1px solid #222; color:#fff; padding:14px 16px; font-family:inherit; font-size:14px;" />
          </div>
          <div style="flex:1;">
            <label style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#888; margin-bottom:8px;">Email</label>
            <input type="email" name="email" required
              style="width:100%; box-sizing:border-box; background:#0a0a0a; border:1px solid #222; color:#fff; padding:14px 16px; font-family:inherit; font-size:14px;" />
          </div>
        </div>

        <div style="margin-bottom:28px;">
          <label style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#888; margin-bottom:8px;">Mobile phone</label>
          <input type="tel" name="phone" required
            style="width:100%; box-sizing:border-box; background:#0a0a0a; border:1px solid #222; color:#fff; padding:14px 16px; font-family:inherit; font-size:14px;" />
        </div>

        <div style="margin-bottom:28px;">
          <label style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#888; margin-bottom:8px;">Message</label>
          <textarea name="message" rows="4" required placeholder="Tell me about the idea, meaning or style you have in mind"
            style="width:100%; box-sizing:border-box; background:#0a0a0a; border:1px solid #222; color:#fff; padding:14px 16px; font-family:inherit; font-size:14px; resize:vertical;"></textarea>
        </div>

        <div style="display:flex; gap:16px; margin-bottom:28px;">
          <div style="flex:1;">
            <label style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#888; margin-bottom:8px;">Placement on your body</label>
            <input type="text" name="placement" required placeholder="example: forearm, calf, full sleeve"
              style="width:100%; box-sizing:border-box; background:#0a0a0a; border:1px solid #222; color:#fff; padding:14px 16px; font-family:inherit; font-size:14px;" />
          </div>
          <div style="flex:1;">
            <label style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#888; margin-bottom:8px;">Approx. size (cm)</label>
            <input type="text" name="size" required placeholder="example: 15x20"
              style="width:100%; box-sizing:border-box; background:#0a0a0a; border:1px solid #222; color:#fff; padding:14px 16px; font-family:inherit; font-size:14px;" />
          </div>
        </div>

        <div style="margin-bottom:28px;">
          <label style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#888; margin-bottom:8px;">What is your budget? (minimum starting fee is €100)</label>
          <input type="text" name="budget" required
            style="width:100%; box-sizing:border-box; background:#0a0a0a; border:1px solid #222; color:#fff; padding:14px 16px; font-family:inherit; font-size:14px;" />
        </div>

        <div style="margin-bottom:28px;">
          <label style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#888; margin-bottom:8px;">Are you tattooed already?</label>
          <select name="already_tattooed" required
            style="width:100%; box-sizing:border-box; background:#0a0a0a; border:1px solid #222; color:#fff; padding:14px 16px; font-family:inherit; font-size:14px;">
            <option value="">Please select</option>
            <option value="No, this will be my first">No, this will be my first</option>
            <option value="Yes, I have a few">Yes, I have a few</option>
            <option value="Yes, I'm heavily tattooed">Yes, I'm heavily tattooed</option>
          </select>
        </div>

        <div style="margin-bottom:28px;">
          <label style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#888; margin-bottom:8px;">Preferred tattoo date</label>
          <input type="date" name="preferred_date"
            style="width:100%; box-sizing:border-box; background:#0a0a0a; border:1px solid #222; color:#fff; padding:14px 16px; font-family:inherit; font-size:14px;" />
        </div>

        <div style="margin-bottom:40px;">
          <label style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#888; margin-bottom:8px;">Reference images / tattoo ideas (max 5)</label>
          <input type="file" name="reference_images" id="reference_images" accept="image/*" multiple
            style="width:100%; box-sizing:border-box; background:#0a0a0a; border:1px solid #222; color:#888; padding:14px 16px; font-family:inherit; font-size:13px;" />
          <p id="file-warning" style="color:#C9A84C; font-size:12px; margin-top:8px; display:none;">Please select a maximum of 5 images.</p>
        </div>

        <button type="submit"
          style="width:100%; background:#C9A84C; color:#000; border:none; padding:18px; font-weight:700; font-size:12px; letter-spacing:0.15em; text-transform:uppercase; cursor:pointer;">
          Send Booking Request
        </button>
      </form>
    </section>

    <script>
      const fileInput = document.getElementById('reference_images');
      const warning = document.getElementById('file-warning');
      const form = document.getElementById('booking-form');

      fileInput?.addEventListener('change', () => {
        if (fileInput.files.length > 5) {
          warning.style.display = 'block';
        } else {
          warning.style.display = 'none';
        }
      });

      form?.addEventListener('submit', (e) => {
        if (fileInput.files.length > 5) {
          e.preventDefault();
          warning.style.display = 'block';
          fileInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    </script>

    <!-- FOOTER -->
    <footer style="border-top:1px solid #111; padding:40px; text-align:center;">
      <p style="color:#333; font-size:12px;">© {new Date().getFullYear()} James Nidecker. All rights reserved.</p>
    </footer>
  </body>
</html>
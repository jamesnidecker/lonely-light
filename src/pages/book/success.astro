---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Request Sent — James Nidecker Tattoo Artist Amsterdam</title>
    <meta name="robots" content="noindex" />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body style="background:#000; color:#fff; margin:0; padding:0; font-family:'Space Grotesk',sans-serif;">

    <nav style="position:fixed; top:0; width:100%; background:#000; border-bottom:1px solid #111; z-index:50; padding:20px 40px; display:flex; align-items:center; justify-content:space-between;">
      <a href="/" style="font-weight:700; letter-spacing:0.2em; text-transform:uppercase; font-size:14px; color:#fff; text-decoration:none;">James Nidecker</a>
      <a href="/" style="color:#666; font-size:12px; letter-spacing:0.15em; text-transform:uppercase; text-decoration:none;">Back to Home</a>
    </nav>

    <section style="min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:40px;">
      <p style="color:#C9A84C; font-size:12px; letter-spacing:0.2em; text-transform:uppercase; margin-bottom:20px;">Thank you</p>
      <h1 style="font-size:32px; margin-bottom:20px; max-width:500px;">Your booking request has been sent</h1>
      <p style="color:#888; max-width:440px; line-height:1.8; font-size:15px; margin-bottom:40px;">
        James reviews every request personally and will get back to you by email as soon as possible.
      </p>
      <a href="/" style="background:#C9A84C; color:#000; padding:16px 40px; font-weight:700; font-size:12px; letter-spacing:0.15em; text-transform:uppercase; text-decoration:none;">Back to Homepage</a>
    </section>
  </body>
</html>